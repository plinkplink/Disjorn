# Disjorn server configuration — copy to server/.env and edit.
#
#   cp deploy/.env.example server/.env
#
# Every variable here maps 1:1 to server/app/config.py (pydantic-settings).
# Relative paths resolve against the process working directory, which is
# server/ both under systemd (WorkingDirectory=) and when run by hand from
# server/. Lines commented out show the built-in default.

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# SQLite database file (WAL mode; -wal/-shm siblings appear next to it).
#DB_PATH=data/disjorn.db

# Runtime data root: uploads/, assets/picker/, assets/chibi_packs/ live here.
#DATA_DIR=data

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# HMAC signing key for signed media URLs etc. REQUIRED in production —
# the "dev-secret-change-me" default is not safe. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-see-comment-above

# The session cookie is named `__Host-disjorn_session`, and browsers honour
# that prefix only on a Secure cookie. Required: the server refuses to boot on
# false, so the house must be served over HTTPS (e.g. `tailscale serve`).
COOKIE_SECURE=true

# Origins allowed to make a cookie-authenticated write or open a
# cookie-authenticated /ws handshake. Exact string match, JSON array, no
# suffix matching — the apps port :8443 is a different origin and stays out.
# Required: an empty list rejects every such request, so the server refuses to
# boot on it. Add dev origins as extra entries.
HOUSE_ORIGINS=["https://<machine>.<tailnet>.ts.net"]

# ---------------------------------------------------------------------------
# Web Push (VAPID)
# ---------------------------------------------------------------------------
# Generate a keypair once and paste the two lines it prints:
#   cd server && .venv/bin/python cli.py gen-vapid
# Leaving these empty disables Web Push (the API returns 503 for push ops).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact claim sent to push services — use a real mailto: you own.
VAPID_CLAIMS_EMAIL=mailto:admin@example.com

# ---------------------------------------------------------------------------
# Media & uploads
# ---------------------------------------------------------------------------
# Max upload size in bytes (default 200 MiB — generous, trusted users).
#MAX_UPLOAD_BYTES=209715200

# Seconds a signed media URL stays valid.
#MEDIA_URL_TTL=3600

# ---------------------------------------------------------------------------
# Pluggable services
# ---------------------------------------------------------------------------
# Ollama endpoint + model used for link summarization.
#OLLAMA_URL=http://localhost:11434
#OLLAMA_MODEL=llama3.2

# Speech-to-text: engine key (services.stt.ENGINES) and whisper model size
# (tiny/base/small/medium/large-v3 — bigger = better + slower; needs the
# requirements-ml.txt extras installed, ideally with a GPU).
#STT_ENGINE=faster_whisper
#STT_MODEL=small

# Summarizer engine key (services.summarize.ENGINES).
#SUMMARIZE_ENGINE=ollama

# ---------------------------------------------------------------------------
# APPS tab (SPECS/2026-08-30-apps-tab-v1.md)
# ---------------------------------------------------------------------------
# These four live here, not in broker.toml's [apps] table, because the server
# never reads broker.toml. The split is by ENFORCER: what the SERVER enforces
# is here, what the BROKER enforces (build_token_ceiling, origin_base, the
# apps-builder spawn) stays there. A knob its enforcer cannot read is not a
# knob.

# Build sessions per user per UTC day. The meter shown in the modal counts
# sessions started since midnight UTC; there is deliberately no daily token cap.
#APPS_DAILY_SESSION_CAP=3

# Seconds a build session's lock survives without a heartbeat. The open modal
# heartbeats; a lock whose deadline has passed is clear, and nothing sweeps —
# so a browser closed mid-build frees the app after this long and no longer.
#APPS_SESSION_LOCK_TTL=900

# The resident seats offered as builders, in the order the chooser shows them.
# JSON array; `bot_id` is a row in `bots` (a configured id with no bot row is
# omitted from the chooser rather than shown as an unpickable card).
# `model_source` is a path READ AT REQUEST TIME so the card prints the model the
# seat actually runs — a `.toml` with a top-level `model = "..."`, or an
# env-style file with CHAT_MODEL= / MODEL=. Unreadable or silent about its model
# prints "model not declared by seat"; there is no model name in the code and
# there must never be one. Empty (the default) is allowed: the tab renders an
# explanatory empty state, which is the honest answer for a house with no build
# seat yet.
# For a .toml source, `model_key` is the dotted path of the pin (default: the
# top-level `model`); Gable's summon.toml keeps it under [container]. An
# env-style source reads CHAT_MODEL= (or MODEL=) and ignores model_key.
#APPS_BUILDERS=[{"bot_id": 2, "model_source": "/srv/disjorn-resident-config/res-gable/summon.toml", "model_key": "container.model"}, {"bot_id": 1, "model_source": "/srv/disjorn-resident-config/res-claudette/env"}]

# Bot names allowed to POST a build-stage event (admin users may too). A stage
# event is an attestation about what a build actually did, so its publishers are
# config a person edits, never something a caller claims about itself.
#APPS_STAGE_PUBLISHER_BOT_NAMES=["broker"]
