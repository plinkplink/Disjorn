[Unit]
Description=Disjorn nightly encrypted offsite snapshot (restic)
OnFailure=disjorn-backup-alert@%n.service
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/disjorn-backup/restic.env
Environment=RESTIC_CACHE_DIR=/var/cache/disjorn-backup
StateDirectory=disjorn-backup
StateDirectoryMode=0700
CacheDirectory=disjorn-backup
UMask=0077
Nice=10
IOSchedulingClass=idle
ExecStart=/bin/bash /home/plink/Disjorn/Disjorn/harness/backup/snapshot.sh
