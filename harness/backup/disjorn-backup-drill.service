[Unit]
Description=Disjorn restore drill: restore newest snapshot to scratch, verify against its manifest, post to #custodian
OnFailure=disjorn-backup-alert@%n.service
Wants=network-online.target
After=network-online.target disjorn-backup-snapshot.service

[Service]
Type=oneshot
EnvironmentFile=/etc/disjorn-backup/restic.env
Environment=RESTIC_CACHE_DIR=/var/cache/disjorn-backup
CacheDirectory=disjorn-backup
PrivateTmp=true
UMask=0077
Nice=10
MemoryMax=8G
ExecStart=/bin/bash /home/plink/Disjorn/Disjorn/harness/backup/drill.sh
