# ── the validator (hand-written; it reads the table, it is not the table) ─

def _validate(verb: str, name: str, spec: dict, value):
    """One argument, every rule the table names for it. Order is deliberate:
    shape first, then the flag-injection guards, then the size caps — so the
    message a caller gets names the thing that is actually wrong with it."""
    flag = spec["flag"]
    if spec["type"] == "integer":
        lo, hi = spec.get("minimum"), spec.get("maximum")
        if lo is not None and hi is not None and not (lo <= value <= hi):
            raise ArgError(f"{flag} must be {lo}..{hi}, got {value}")
        return value

    if spec.get("json_arg"):
        try:
            parsed = json.loads(value)
        except json.JSONDecodeError as exc:
            raise ArgError(f"{flag} is not valid JSON: {exc}") from exc
        if spec["type"] == "object" and not isinstance(parsed, dict):
            raise ArgError(f"{flag} must be a JSON object")
        cap = spec.get("max_json_bytes")
        if cap is not None and len(json.dumps(parsed)) > cap:
            raise ArgError(f"{flag} serialized must be <= {cap} bytes")
        return parsed

    text = str(value)
    # NO ARGUMENT MAY BECOME A FLAG. Checked here as well as broker-side, at
    # every layer, however trusted the layer above is said to be.
    if spec.get("no_leading_dash") and text.startswith("-"):
        raise ArgError(f"{flag} must not start with '-'")
    if spec.get("no_nul") and "\x00" in text:
        raise ArgError(f"{flag} must not contain NUL")
    if spec.get("absolute_path") and not text.startswith("/"):
        raise ArgError(f"{flag} must be an absolute path")
    if spec.get("no_dotdot") and ".." in text.split("/"):
        raise ArgError(f"{flag} must not contain '..' segments")
    lo, hi = spec.get("min_len"), spec.get("max_len")
    if (lo is not None or hi is not None) and not (
            (lo or 0) <= len(text) <= (hi if hi is not None else len(text))):
        raise ArgError(f"{flag} must be {lo}..{hi} chars, got {len(text)}")
    pattern = spec.get("pattern")
    if pattern and not re.match(pattern, text):
        raise ArgError(f"{flag} must match {pattern}")
    return text


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="broker",
        description="Resident CLI for the disjorn-broker (PROTOCOL.md v1).",
    )
    parser.add_argument(
        "--socket",
        default=None,
        help=f"socket path (default: $BROKER_SOCKET or {DEFAULT_SOCKET})",
    )
    sub = parser.add_subparsers(dest="verb", required=True)
    for verb, entry in VERB_SURFACE.items():
        p = sub.add_parser(verb, help=entry["help"])
        for name, spec in entry["args"].items():
            # dest is always explicit: '--from' would otherwise derive the
            # dest `from`, which is a keyword and unreachable on a Namespace.
            p.add_argument(spec["flag"], dest=name, default=None,
                           required=spec["required"], help=spec["help"],
                           type=int if spec["type"] == "integer" else str)
    return parser


def build_request(verb: str, ns: argparse.Namespace) -> dict:
    """Validate ns per the verb's mirrored schema; return the request object.

    Omitted optional flags are DROPPED, never sent as null: defaults are the
    broker's to decide, and a null in the request is a value, not an absence."""
    entry = VERB_SURFACE.get(verb)
    if entry is None:
        raise ArgError(f"unknown verb {verb!r}")
    args: dict = {}
    for name, spec in entry["args"].items():
        value = getattr(ns, name, None)
        if value is None:
            continue
        args[name] = _validate(verb, name, spec, value)
    return {"verb": verb, "args": args}


def call_broker(socket_path: str, request: dict) -> dict:
    """One connection, one newline-terminated JSON request, one response."""
    payload = (json.dumps(request, ensure_ascii=False) + "\n").encode("utf-8")
    if len(payload) > MAX_REQUEST_BYTES:
        raise ArgError(f"request exceeds {MAX_REQUEST_BYTES} bytes")
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
        sock.settimeout(TIMEOUT_SECONDS)
        sock.connect(socket_path)
        sock.sendall(payload)
        chunks: list[bytes] = []
        while True:
            chunk = sock.recv(65536)
            if not chunk:
                break
            chunks.append(chunk)
            if chunk.endswith(b"\n"):
                break
    raw = b"".join(chunks)
    if not raw:
        raise ConnectionError("broker closed the connection without a response")
    return json.loads(raw.decode("utf-8"))


def _emit(obj: dict) -> None:
    print(json.dumps(obj, indent=2, ensure_ascii=False))


def main(argv: list[str] | None = None, environ: dict = os.environ) -> int:
    if environ.get("BROKER_DISABLE"):
        _emit({"ok": False, "error": {
            "code": "broker-disabled-local",
            "message": "BROKER_DISABLE is set in this resident's env "
                       "(plink's kill switch); no call was made."}})
        return EXIT_DISABLED

    parser = build_parser()
    ns = parser.parse_args(argv)

    try:
        request = build_request(ns.verb, ns)
    except ArgError as exc:
        _emit({"ok": False, "error": {"code": "bad-args-local",
                                      "message": str(exc)}})
        return EXIT_USAGE

    socket_path = ns.socket or environ.get("BROKER_SOCKET", DEFAULT_SOCKET)
    try:
        response = call_broker(socket_path, request)
    except ArgError as exc:
        _emit({"ok": False, "error": {"code": "bad-args-local",
                                      "message": str(exc)}})
        return EXIT_USAGE
    except (OSError, ConnectionError, json.JSONDecodeError) as exc:
        _emit({"ok": False, "error": {
            "code": "transport",
            "message": f"{type(exc).__name__}: {exc} (socket: {socket_path})"}})
        return EXIT_TRANSPORT

    _emit(response)
    if response.get("ok") is True:
        return EXIT_OK
    code = (response.get("error") or {}).get("code", "internal")
    return ERROR_EXIT.get(code, ERROR_EXIT["internal"])


if __name__ == "__main__":
    sys.exit(main())
