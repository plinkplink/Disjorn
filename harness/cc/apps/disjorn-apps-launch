MODES = ("run", "stop", "publish", "revert", "remix",
         "publish-as-seat", "revert-as-seat", "remix-as-seat")


def die(msg: str) -> "None":
    """Every refusal, and the only way out that is not an exec. Exit 64 before
    any privilege is used (spec §C)."""
    sys.stderr.write(f"disjorn-apps-launch: REFUSED: {msg}\n")
    raise SystemExit(EXIT_REFUSED)


def fail(msg: str) -> "None":
    """A serving operation that was ALLOWED and then broke. Distinct from a
    refusal because the caller's contract distinguishes them: 64 means the
    house asked for something it may not have, anything else means the house
    asked for something reasonable and the host could not do it."""
    sys.stderr.write(f"disjorn-apps-launch: FAILED: {msg}\n")
    raise SystemExit(EXIT_FAILED)


def warn(msg: str) -> None:
    sys.stderr.write(f"disjorn-apps-launch: {msg}\n")


# ---------------------------------------------------------------- validation

def check_principal(raw: str) -> str:
    """The prompt-directory principal: `res-<name>`, spec §C's charset and
    nothing else. NOT a uid — the turn always runs as res-appsbuilding."""
    if not RESIDENT_RE.match(raw):
        die(f"resident is not res-<name>: {raw!r}")
    return raw


def check_session(raw: str) -> str:
    if not SESSION_RE.match(raw):
        die(f"session id is not a bare positive integer: {raw!r}")
    return raw


def check_turn(raw: str) -> str:
    if not TURN_RE.match(raw):
        die(f"turn is not 1-9999: {raw!r}")
    return raw


def check_app_id(raw: str) -> str:
    """Stage 1's base32-lower app id. It becomes a directory name under three
    /srv roots and a podman --name component, so anything that could read as a
    path segment, a flag or a unit-name escape is out by construction."""
    if not APP_ID_RE.match(raw):
        die(f"app id is not 12 lowercase base32 characters: {raw!r}")
    return raw


def load_config(path: str) -> dict:
    """The config table this program reads ITSELF — the mapped prompt
    directories, the runner argv, the model, the ponytail intensity and the
    turn clock. Not arguments, because a caller that could name the prompt
    directory could name any directory."""
    if tomllib is None:                                   # pragma: no cover
        die("python is too old for tomllib; cannot read the launch config")
    try:
        with open(path, "rb") as fh:
            return tomllib.load(fh)
    except FileNotFoundError:
        die(f"launch config missing: {path} "
            f"(install it from harness/cc/apps/launch.toml.example)")
    except OSError as exc:
        die(f"launch config unreadable: {path}: {exc}")
    except Exception as exc:                              # tomllib decode error
        die(f"launch config is not valid TOML: {path}: {exc}")


def _prompt_limit(config: dict) -> int:
    apps = config.get("apps") or {}
    limit = apps.get("prompt_max_bytes", DEFAULT_PROMPT_MAX_BYTES)
    if not isinstance(limit, int) or limit <= 0:
        die("[apps].prompt_max_bytes must be a positive integer")
    return limit


def _under(root: str, real: str) -> bool:
    """Segment-wise containment: `/a/b-evil/x` is not under `/a/b`."""
    return real == root or real.startswith(root.rstrip("/") + os.sep)


def principal_uid(principal: str, root: str) -> int:
    """WHO the principal is on this disk: the owner of its mapped prompt
    directory (already realpath'd by the caller). Root-owned config names the
    directory; the directory's owner names the uid; a prompt file must carry
    that uid. Root is refused at both ends — a root-owned prompt directory is
    a misconfiguration, not a principal.

    KNOWN EDGE (Claudette #2336): this rule stops distinguishing two
    principals the day launch.toml maps two [prompt_dirs] entries to
    directories owned by the SAME uid — the check degrades to "somebody's,
    not root's" with no error. Today no two entries share an owner; whoever
    adds a second directory for an existing owner has to add the
    distinguishing check here too."""
    try:
        st = os.stat(root)
    except OSError as exc:
        die(f"cannot stat {principal}'s prompt directory {root!r}: {exc}")
    if not stat.S_ISDIR(st.st_mode):
        die(f"{principal}'s mapped prompt directory is not a directory: {root!r}")
    if st.st_uid == 0:
        die(f"{principal}'s prompt directory {root!r} is owned by root — refused")
    return st.st_uid


def open_prompt(principal: str, raw: str, config: dict) -> int:
    """Open the prompt ONCE and establish everything about it from the fd.

    THIS IS THE PATH WALL, and the thing behind it is a file, not a name
    (Claudette's second slice-(i) block: a check about a name followed by a
    read of the name is two windows for the principal — who is exactly the
    party modelled as possibly prompt-injected — to swap in a symlink and have
    root read the credential file onto a build hand's stdin). So:

      1. the NAME is checked (absolute, no control bytes, under the mapped
         directory after realpath) — a cheap first refusal with a good
         message, not the wall;
      2. the file is opened with O_NOFOLLOW (the final component may not be
         a symlink at all — a resident writes a regular file), O_CLOEXEC,
         and O_NONBLOCK — a FIFO is not a symlink, and without O_NONBLOCK a
         planted one would park this root process in open() forever, under
         sudo, before fstat could say "not a regular file" (Claudette #2320).
         The flag is cleared again once the file is known to be regular,
         where it was a no-op anyway;
      3. IDENTITY comes from the fd: fstat says regular file and gives the
         size for the bound; fstat also says WHOSE it is, and that must be
         the principal's own uid — never root's — which is what closes the
         hardlink-into-the-prompt-dir shape in code rather than by whatever
         fs.protected_hardlinks is set to on the box (Claudette #2320);
         /proc/self/fd/N says which path the kernel actually opened, and
         that path — not the one we were handed — must sit segment-wise
         under the realpath'd mapped directory. An intermediate-directory
         swap between (1) and (2) lands here.

    "The principal's uid" is read off the mapped directory itself: the
    root-owned config says which directory is `res-gable`'s, and the owner of
    that directory is who `res-gable` is on this disk. No passwd lookup —
    the fact under test is who owns the tree the prompt came out of, not who
    is in /etc/passwd — and a root-owned prompt directory is refused as the
    misconfiguration it is.

    The fd is returned and READ FROM; nothing reopens the name. Callers that
    only want validation close it.
    """
    principal = check_principal(principal)
    dirs = config.get("prompt_dirs")
    if not isinstance(dirs, dict):
        die("launch config has no [prompt_dirs] table")
    mapped = dirs.get(principal)
    if not isinstance(mapped, str) or not mapped:
        die(f"no prompt directory mapped for {principal!r} "
            f"(add it under [prompt_dirs] in the launch config)")
    if not mapped.startswith("/"):
        die(f"mapped prompt directory for {principal!r} is not absolute: {mapped!r}")

    if len(raw) > MAX_PATH_LEN:
        die("prompt path too long")
    if "\0" in raw or "\n" in raw or "\r" in raw:
        die("prompt path contains a control character")
    if not raw.startswith("/"):
        die(f"prompt path is not absolute: {raw!r}")

    root = os.path.realpath(mapped)
    named = os.path.realpath(raw)
    if not _under(root, named):
        die(f"prompt path escapes {principal}'s prompt directory: "
            f"{raw!r} resolves to {named!r}, outside {root!r}")
    owner = principal_uid(principal, root)

    limit = _prompt_limit(config)
    try:
        fd = os.open(raw, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC
                     | os.O_NONBLOCK)
    except OSError as exc:
        # ELOOP is what O_NOFOLLOW raises for a symlink final component.
        die(f"cannot open prompt (a symlink is refused; a regular file is required): {exc}")
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            die("prompt is not a regular file")
        # Regular from here on: O_NONBLOCK did its one job at open() and
        # means nothing on a regular file, so clear it rather than leave a
        # flag on an fd that gets read from.
        fcntl.fcntl(fd, fcntl.F_SETFL,
                    fcntl.fcntl(fd, fcntl.F_GETFL) & ~os.O_NONBLOCK)
        if st.st_uid == 0:
            die("prompt file is owned by root — a resident writes its own prompts")
        if st.st_uid != owner:
            die(f"prompt file is owned by uid {st.st_uid}, not by {principal} "
                f"(uid {owner}) — refused")
        if st.st_size == 0:
            die("prompt file is empty")
        if st.st_size > limit:
            die(f"prompt file is {st.st_size} bytes, over the {limit}-byte bound")
        try:
            actual = os.readlink(f"/proc/self/fd/{fd}")
        except OSError as exc:
            die(f"cannot establish the opened file's identity: {exc}")
        if not _under(root, actual):
            die(f"the opened prompt is {actual!r}, outside {root!r} — refused")
    except SystemExit:
        os.close(fd)
        raise
    return fd


def read_prompt_fd(fd: int, config: dict) -> bytes:
    """The bytes behind the fd open_prompt returned, bounded once more against
    a file that grew after fstat. The fd is closed on return."""
    limit = _prompt_limit(config)
    try:
        chunks = []
        got = 0
        while True:
            chunk = os.read(fd, 65536)
            if not chunk:
                break
            got += len(chunk)
            if got > limit:
                die("prompt file grew past the bound while being read")
            chunks.append(chunk)
    finally:
        os.close(fd)
    data = b"".join(chunks)
    if not data:
        die("prompt file is empty")
    return data


def prompt_on_stdin(data: bytes) -> int:
    """Hand the bounded prompt bytes to the unit on STDIN, and write nothing.

    Claudette's review block (#custodian, slice (i)): root must never create
    or chown anything inside a seat-writable tree — a pre-planted symlink at
    the turn directory or at `prompt.md.tmp` turns a root write into
    seat-to-root. So root stages NOTHING under /srv/apps-turns. Instead the
    validated bytes go into an anonymous memfd, which becomes this process's
    stdin; `systemd-run --pipe` inherits it, so the unit's stdin IS the
    prompt. The wrapper, running as the seat, copies it into its own result
    directory. No path, no race, no privilege on the wrong side of the line.
    """
    fd = os.memfd_create("apps-prompt", 0)
    view = memoryview(data)
    while view:
        n = os.write(fd, view)
        view = view[n:]
    os.lseek(fd, 0, os.SEEK_SET)
    os.dup2(fd, 0)
    os.close(fd)
    return 0


def check_runner_command(config: dict) -> "list":
    """`[runner] command` becomes argv INSIDE the container. It is config
    (plink's), never anything a resident composed — but it is still bounded and
    control-character-free so nothing weird reaches the process table."""
    runner = config.get("runner") or {}
    command = runner.get("command", DEFAULT_RUNNER_COMMAND)
    if not isinstance(command, list) or not command:
        die("[runner] command must be a non-empty array of strings")
    if len(command) > MAX_RUNNER_ARGS:
        die(f"[runner] command has too many arguments ({len(command)})")
    for arg in command:
        if not isinstance(arg, str):
            die("[runner] command must contain only strings")
        if len(arg) > MAX_ARG_LEN:
            die("[runner] command argument too long")
        if any(c in arg for c in ("\0", "\n", "\r")):
            die("[runner] command argument contains a control character")
    return list(command)


def check_model(config: dict) -> str:
    model = (config.get("runner") or {}).get("model", DEFAULT_MODEL)
    if not isinstance(model, str) or not MODEL_RE.match(model):
        die(f"[runner] model is not a plain model id: {model!r}")
    return model


def check_apps_table(config: dict) -> "tuple":
    """`[apps]` — the turn clock, the ponytail intensity, the image."""
    apps = config.get("apps") or {}
    turn_max = apps.get("turn_max_sec", DEFAULT_TURN_MAX_SEC)
    if not isinstance(turn_max, int) or isinstance(turn_max, bool) \
            or not (1 <= turn_max <= 86400):
        die(f"[apps] turn_max_sec is not 1..86400 seconds: {turn_max!r}")
    mode = apps.get("ponytail_mode", DEFAULT_PONYTAIL_MODE)
    if not isinstance(mode, str) or not PONYTAIL_RE.match(mode):
        die(f"[apps] ponytail_mode is not off|lite|full|ultra: {mode!r}")
    image = apps.get("image", DEFAULT_IMAGE)
    if not isinstance(image, str) or not image or any(
            c in image for c in (" ", "\0", "\n", "\r")):
        die(f"[apps] image is not a plain image reference: {image!r}")
    return turn_max, mode, image


def check_seat() -> "tuple":
    """Resolve res-appsbuilding, or refuse. The account must ALREADY EXIST —
    creating one needs root, so passwd membership is a fact this program cannot
    be talked into. uid/gid 0 are refused explicitly: the entire point is that
    the turn does not run as root."""
    try:
        pw = pwd.getpwnam(SEAT_USER)
    except KeyError:
        die(f"no such seat account: {SEAT_USER} "
            f"(run harness/keyboard/10-appsbuilding.sh)")
    if pw.pw_uid == 0 or pw.pw_gid == 0:
        die(f"{SEAT_USER} resolves to uid/gid 0 — refusing to run a turn as root")
    try:
        group = grp.getgrgid(pw.pw_gid).gr_name
    except KeyError:
        group = str(pw.pw_gid)
    return pw, group


def check_wrapper(path: str) -> None:
    """The wrapper must be a root-owned regular file that no one else can
    write. If plink could rewrite it, `sudo <helper>` would become `sudo
    <anything>` — as res-appsbuilding, not as root, but still not a boundary
    anyone should have to argue about."""
    try:
        st = os.stat(path)
    except OSError as exc:
        die(f"launch wrapper unusable: {exc}")
    if not stat.S_ISREG(st.st_mode):
        die(f"launch wrapper is not a regular file: {path}")
    if st.st_uid != 0:
        die(f"launch wrapper is not root-owned: {path} (uid {st.st_uid})")
    if st.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
        die(f"launch wrapper is group- or world-writable: {path}")


# ------------------------------------------------------------------ the argv

def build_run_argv(principal: str, session: str, turn: str, app_id: str,
                   prompt_path: str, config: dict, *, wrapper: str = WRAPPER,
                   harvest: str = HARVEST, seat=None, prompt_fd=None) -> "list":
    """Every check, then the exact systemd-run argv. Factored out so the test
    suite can assert the argv byte for byte without a systemd on the other end
    — the argv IS the contract between this program and the unit."""
    principal = check_principal(principal)
    session = check_session(session)
    turn = check_turn(turn)
    app_id = check_app_id(app_id)
    if prompt_fd is None:
        # Validation only (dry runs, tests): open the wall once and let go.
        os.close(open_prompt(principal, prompt_path, config))
    command = check_runner_command(config)
    model = check_model(config)
    turn_max, ponytail_mode, image = check_apps_table(config)
    pw, group = seat if seat is not None else check_seat()

    unit = f"{UNIT_PREFIX}{session}-{turn}"
    # The unit gets the prompt on STDIN (see prompt_on_stdin), never a path:
    # the seat cannot read a home, and root writes nothing in the seat's tree.
    return [
        SYSTEMD_RUN,
        # Deterministic and greppable, and a second launch of the same turn
        # collides LOUDLY ("Unit ... was already loaded") instead of racing the
        # repo and the podman --name. The broker's one-turn-per-session claim
        # (§E.4) is the first line of that defence; this is the kernel's.
        f"--unit={unit}",
        f"--description=Disjorn apps turn {session}/{turn} ({app_id})",
        # THE IDENTITY. PID 1 sets the credentials, so podman's keep-id and
        # $HOME are res-appsbuilding's by construction rather than convention,
        # and everything the turn writes under /srv/apps is owned by the one
        # account that owns /srv/apps.
        f"--uid={SEAT_USER}",
        f"--gid={group}",
        # Unload the transient unit when it finishes, success or failure, so a
        # failed turn never blocks the next turn of the same session.
        "--collect",
        # Pass OUR stdin/stdout/stderr through untouched. The unit holds its
        # own dups, so it keeps running — and keeps writing its spools and
        # result.json — after this process and the broker are gone. That is
        # what makes the turn's completion a fact the unit recorded rather than
        # something the broker had to be awake to witness (spec §C).
        "--pipe",
        # Kernel-enforced envelope (the constants above; spec §A).
        f"--property=RuntimeMaxSec={turn_max}",
        f"--property=MemoryMax={MEMORY_MAX}",
        f"--property=LimitFSIZE={LIMIT_FSIZE}",
        "--property=LimitCORE=0",
        f"--property=TasksMax={TASKS_MAX}",
        # rootless podman needs the seat's own runtime dir (lingering is on,
        # 10-appsbuilding.sh), and a res-* uid cannot traverse /home/plink, so
        # nothing may default to a path under it.
        f"--setenv=XDG_RUNTIME_DIR=/run/user/{pw.pw_uid}",
        f"--setenv=HOME={pw.pw_dir}",
        # Everything the wrapper needs, from the ONE table this program read.
        # The wrapper reads no config of its own: two readers of one file is
        # the drift shape this project pays for most often.
        f"--setenv=APPS_SESSION={session}",
        f"--setenv=APPS_TURN={turn}",
        f"--setenv=APPS_APP_ID={app_id}",
        f"--setenv=APPS_IMAGE={image}",
        f"--setenv=APPS_MODEL={model}",
        f"--setenv=APPS_PONYTAIL_MODE={ponytail_mode}",
        f"--setenv=APPS_RUNNER_COMMAND={json.dumps(command)}",
        f"--setenv=APPS_TURN_MAX_SEC={turn_max}",
        f"--setenv=APPS_PROMPT_MAX_BYTES={_prompt_limit(config)}",
        f"--setenv=APPS_REPO_ROOT={APPS_ROOT}",
        f"--setenv=APPS_TURNS_ROOT={TURNS_ROOT}",
        f"--setenv=APPS_WWW_ROOT={WWW_ROOT}",
        f"--setenv=APPS_QUARANTINE_ROOT={QUARANTINE_ROOT}",
        f"--setenv=APPS_CONFIG_DIR={CONFIG_DIR}",
        f"--setenv=APPS_HARVEST={harvest}",
        "--",
        wrapper, session, turn, app_id,
    ]


# ------------------------------------------------------------------ stop

def build_stop_argv(principal: str, session: str, turn: str) -> "list":
    """Every check, then the exact systemctl argv. The principal is validated
    and otherwise unused: `stop` takes it so the sudoers line and the audit
    trail name the same caller `run` did, and so the argument shapes are one
    set, not two."""
    check_principal(principal)
    session = check_session(session)
    turn = check_turn(turn)
    return [SYSTEMCTL, "stop", f"{UNIT_PREFIX}{session}-{turn}"]


class MarkerRefused(Exception):
    """The marker could not be written and the reason why. Never fatal on
    the stop path — see the header. Raised instead of die()'d so main_stop
    decides what a refusal costs."""


def drop_stop_marker(session: str, turn: str, seat_uid: int, *,
                     turns_root: str = TURNS_ROOT) -> bool:
    """Create `<turns_root>/<session>/<turn>/stop-requested`, as root, without
    ever following a symlink or writing under a directory the seat does not
    own. True if created, False if it already existed; MarkerRefused with the
    reason when it cannot be written at all.

    The turn dir was created by the seat (run-apps.sh, mkdir -p) and the seat
    controls its contents; root writing there by name would follow whatever
    the seat planted. So: open the root with O_DIRECTORY|O_NOFOLLOW, walk one
    component at a time with openat under the same flags, fstat each and
    refuse anything not a directory owned by the seat, then create the marker
    O_CREAT|O_EXCL|O_NOFOLLOW at the final fd. A missing turn dir is a turn
    that never started (or already cleaned up) and is refused, not created —
    this program makes no directories in the seat's tree.

    Root still makes no directory here: a missing turn dir is refused, and
    the caller decides whether that stops anything (it does not)."""
    flags = os.O_RDONLY | os.O_DIRECTORY | getattr(os, "O_NOFOLLOW", 0)
    try:
        fd = os.open(turns_root, flags)
    except OSError as exc:
        raise MarkerRefused(f"turns root unavailable: {turns_root}: {exc.strerror}")
    try:
        st = os.fstat(fd)
        if not stat.S_ISDIR(st.st_mode):
            raise MarkerRefused(f"turns root is not a directory: {turns_root}")
        for name in (session, turn):
            try:
                nfd = os.open(name, flags, dir_fd=fd)
            except FileNotFoundError:
                raise MarkerRefused(f"no turn dir yet: {session}/{turn}")
            except OSError as exc:
                raise MarkerRefused(f"cannot open {name} under the turns root: {exc.strerror}")
            os.close(fd)
            fd = nfd
            st = os.fstat(fd)
            if not stat.S_ISDIR(st.st_mode) or st.st_uid != seat_uid:
                raise MarkerRefused(
                    f"{session}/{turn}: directory is not the seat's own "
                    f"(uid {st.st_uid}, expected {seat_uid}) — not writing")
        try:
            mfd = os.open(STOP_MARKER,
                          os.O_WRONLY | os.O_CREAT | os.O_EXCL
                          | getattr(os, "O_NOFOLLOW", 0),
                          0o644, dir_fd=fd)
        except FileExistsError:
            return False
        except OSError as exc:
            raise MarkerRefused(f"cannot drop the stop marker: {exc.strerror}")
        os.close(mfd)
        return True
    finally:
        os.close(fd)


def _marker_best_effort(session: str, turn: str, seat_uid: int, *,
                        turns_root: str = TURNS_ROOT):
    """The marker, or the reason there is none. Never raises: the stop is
    sent either way, and a refusal here is a warning the unit's journal
    keeps, not an exit."""
    try:
        return drop_stop_marker(session, turn, seat_uid, turns_root=turns_root)
    except MarkerRefused as exc:
        sys.stderr.write(f"disjorn-apps-launch: stop marker not written "
                         f"({exc}); the stop is sent regardless and the room "
                         f"will read this turn as timed out\n")
        return str(exc)


def main_stop(argv: "list", *, dry: bool, seat) -> int:
    if len(argv) != 5:
        die(f"stop takes exactly 3 arguments, got {len(argv) - 2}")
    out = build_stop_argv(argv[2], argv[3], argv[4])
    if dry:
        # A dry run says what it WOULD do, writing the marker only on a root
        # the test names. `marker` is True (created), False (already there),
        # or the reason it was not written — and the argv is present in all
        # three, which is the property the whole path rests on.
        root = os.environ.get("DISJORN_APPS_LAUNCH_TURNS_ROOT")
        if root:
            marker = _marker_best_effort(argv[3], argv[4], seat[0].pw_uid,
                                         turns_root=root)
            print(json.dumps({"argv": out, "marker": marker}))
        else:
            print(json.dumps(out))
        return 0
    pw, _group = seat
    _marker_best_effort(argv[3], argv[4], pw.pw_uid)
    os.execve(out[0], out, {"PATH": "/usr/sbin:/usr/bin:/sbin:/bin"})
    die(f"exec failed: {out[0]}")   # pragma: no cover
    return EXIT_REFUSED


# ------------------------------------------- publish / revert / remix (D6)
#
# THE SHAPE OF THIS HALF. Everything below either (a) validates and builds a
# systemd-run argv — root's half, which touches no file — or (b) moves
# directories, which only ever runs as res-appsbuilding inside that unit. The
# functions in (b) all take their roots as arguments, so the whole rotate is
# exercised by the test suite against a tmp tree with no privilege anywhere.

STAGING_NAME = ".staging"                # apps_harvest.STAGING_NAME
LIVE_NAME = "live"
PREV_NAME = "live.prev"
PREVIEW_NAME = "preview"


def _stamp() -> str:
    """A per-operation suffix for a staged tree. Nanoseconds, so two publishes
    of one app cannot collide on the name even if the unit-name collision that
    should have stopped the second one somehow did not."""
    return str(time.time_ns())


def _remove(path: Path) -> None:
    """Remove a leftover of OURS, whatever shape it has — a symlink is
    unlinked, never followed. Same function, same reasoning, as
    apps_harvest._remove: it only ever runs on names this program creates
    under the unserved staging root, or on the live.prev this program's own
    rotate put there."""
    if path.is_symlink() or path.is_file():
        path.unlink()
    elif path.is_dir():
        shutil.rmtree(path)


def _real_dir(path: Path) -> bool:
    """A directory, and not a symlink to one. The seat owns /srv/apps-www and
    could put a link where a tree belongs; rsync's `--no-links` drops links
    INSIDE a transfer but happily follows a source path that is one, so a
    `preview -> /etc` would otherwise be published to the public root."""
    return path.is_dir() and not path.is_symlink()


def _is_a_real_repo(src: Path) -> bool:
    """`<src>/.git` is a real DIRECTORY that lives inside `<src>` itself.

    THE SENTENCE THIS FILE KEEPS RELEARNING (Gable #2546; Claudette #2325,
    #2329 before it): we keep validating WHERE a thing is instead of WHAT it
    is. `(src / ".git").exists()` was the whole parent check, and `.git` is
    allowed to be a FILE — forty bytes reading `gitdir: /srv/apps/<other>/.git`
    makes any directory a working tree of somebody else's repository. A turn
    writes /work, so a builder turn could have written those forty bytes and
    turned "remix this app" into "clone that one". A symlinked `.git` is the
    same trick with a different syscall.

    So: not a symlink, a directory by lstat rather than by follow, and its
    realpath lands under the realpath of the app's own directory. A repo the
    seat owns and points somewhere else is not a repo this remix will read."""
    dot_git = src / ".git"
    if dot_git.is_symlink():
        return False
    if not dot_git.is_dir():                 # a `gitdir:` pointer file is not
        return False
    try:
        real_src = os.path.realpath(src)
        real_git = os.path.realpath(dot_git)
    except OSError:                          # pragma: no cover — lstat'd above
        return False
    return _under(real_src, real_git) and real_git != real_src


def _staging(www_root, app_id: str) -> Path:
    """`<www-root>/.staging/<app-id>/`, created 0700 at the `.staging` level.

    NOT a sibling of `live` under `<app-id>/`: `<www-root>/<app-id>/` is a
    served directory in stage 3, so a half-copied tree beside `live` would be
    a URL for as long as it existed (Claudette #2336, the same ruling the
    preview publisher was built on). `.staging` cannot collide with an app id
    — `^[a-z2-7]{12}$` has no dot — and it is the same filesystem, so every
    rename below is a rename."""
    root = Path(www_root)
    staging = root / STAGING_NAME / app_id
    staging.mkdir(parents=True, exist_ok=True)
    os.chmod(staging.parent, 0o700)
    return staging


def snapshot_argv(src, dest, rsync_bin: str = RSYNC) -> "list":
    """The rsync argv for a served-tree snapshot, factored out so a test can
    assert it without rsync installed.

    The flags are apps_harvest.preview_argv's, and they are the same flags for
    the same reasons: `--no-links` drops symlinks as a CLASS, `--no-D` drops
    devices, FIFOs and sockets, `--chmod=D0755,F0644` sets the modes stage 3
    serves rather than walking the tree with os.chmod afterwards. No
    `--exclude` here: the SOURCE is a preview root the harvest already built
    with those exclusions, and re-applying them would mean `live` could
    silently differ from the `preview` the owner pressed Live on. No
    `--delete`: the destination is a fresh empty directory. Trailing slashes:
    the contents, not the directory."""
    return [rsync_bin, "-a", "--no-links", "--no-D", "--chmod=D0755,F0644",
            f"{str(src).rstrip('/')}/", f"{str(dest).rstrip('/')}/"]


def _snapshot_into(src: Path, dest: Path, rsync_bin: str) -> None:
    """A fresh 0755 `dest`, filled by rsync. On failure the destination is
    removed and the caller fails: nothing has been renamed yet, so the served
    tree is untouched."""
    _remove(dest)
    os.mkdir(dest, 0o755)
    os.chmod(dest, 0o755)                # our own fresh directory, umask-proof
    argv = snapshot_argv(src, dest, rsync_bin=rsync_bin)
    proc = subprocess.run(argv, capture_output=True, text=True)
    if proc.returncode != 0:
        shutil.rmtree(dest, ignore_errors=True)
        fail(f"rsync into the staging tree failed ({proc.returncode}): "
             f"{(proc.stderr or proc.stdout).strip()}")


def publish_app(www_root, app_id: str, *, rsync_bin: str = RSYNC,
                stamp: "str | None" = None) -> dict:
    """`preview/` → `live/`, by rename, keeping the old `live/` as `live.prev/`.

    THE ROTATE, and the only reason this is a function and not four lines in
    main: it is the part with an order that matters, and it is tested against
    a tmp tree.

      1. snapshot `preview/` into `<staging>/live.tmp.<ts>` (a COPY, because
         `preview` must keep existing — the owner goes on building);
      2. remove any `live.prev` (it is two deploys old; `revert` only ever
         reaches back one);
      3. `live` → `live.prev`, if there is a `live`;
      4. staged tree → `live`.

    Steps 3 and 4 are two renames because a rename cannot replace a non-empty
    directory in one syscall. The window between them is the only instant a
    reader sees no `live` at all, and it is the same instant either way. If
    step 4 fails, step 3 is undone and the tree that was serving is serving
    again."""
    app_id = check_app_id(app_id)
    root = Path(www_root)
    app_dir = root / app_id
    preview = app_dir / PREVIEW_NAME
    live = app_dir / LIVE_NAME
    prev = app_dir / PREV_NAME

    if not _real_dir(preview):
        die(f"{app_id} has no preview to publish "
            f"(no turn of this app has deployed yet)")

    staged = _staging(root, app_id) / f"{LIVE_NAME}.tmp.{stamp or _stamp()}"
    _snapshot_into(preview, staged, rsync_bin)

    if prev.exists() or prev.is_symlink():
        _remove(prev)
    had_live = live.exists() or live.is_symlink()
    if had_live:
        os.rename(live, prev)
    try:
        os.rename(staged, live)
    except OSError:
        if had_live:
            os.rename(prev, live)
        raise
    return {"mode": "publish", "app": app_id, "live": str(live),
            "previous": had_live}


def revert_app(www_root, app_id: str, *, stamp: "str | None" = None) -> dict:
    """Swap `live` and `live.prev`. Three renames through a name under the
    staging root, because two directories cannot trade places in two.

    Both must exist: a revert with no previous deploy is a refusal, not a
    no-op, because the server offers the button only when there IS one and a
    silent success would make a lie of the button. The swap is symmetric —
    reverting a revert puts the newer tree back — which is why the old live
    goes to `live.prev` rather than being removed."""
    app_id = check_app_id(app_id)
    root = Path(www_root)
    app_dir = root / app_id
    live = app_dir / LIVE_NAME
    prev = app_dir / PREV_NAME
    if not _real_dir(live):
        die(f"{app_id} is not live, so there is nothing to revert")
    if not _real_dir(prev):
        die(f"{app_id} has no previous deploy to revert to")

    tmp = _staging(root, app_id) / f"{LIVE_NAME}.swap.{stamp or _stamp()}"
    _remove(tmp)
    os.rename(live, tmp)
    try:
        os.rename(prev, live)
    except OSError:
        os.rename(tmp, live)             # nothing moved; the older tree stays
        raise
    try:
        os.rename(tmp, prev)
    except OSError as exc:
        # `live` is already the tree the user asked for, which is the whole
        # point of the button. Losing the far side of the swap costs the next
        # revert, not this one, so it is a warning and not a failure.
        warn(f"reverted, but the superseded tree is still at {tmp}: {exc}")
    return {"mode": "revert", "app": app_id, "live": str(live)}


def _git(args: "list", *, cwd=None, git_bin: str = GIT) -> str:
    """git with an environment this program built, never one it inherited.

    Same shape as apps_harvest.git: no system or global config (a config file
    the seat can write is a config file that can name a program), hooks off
    (`core.hooksPath=/dev/null` — a clone of a repo the seat controls must not
    run the seat's shell scripts as anybody), C locale, and the author
    identity fixed so the lineage commit is the app builder's."""
    env = {
        "PATH": "/usr/local/bin:/usr/bin:/bin",
        "HOME": os.environ.get("HOME", "/tmp"),
        "GIT_TERMINAL_PROMPT": "0",
        "GIT_CONFIG_NOSYSTEM": "1",
        "GIT_CONFIG_GLOBAL": "/dev/null",
        "LC_ALL": "C",
        "GIT_AUTHOR_NAME": GIT_USER_NAME,
        "GIT_AUTHOR_EMAIL": GIT_USER_EMAIL,
        "GIT_COMMITTER_NAME": GIT_USER_NAME,
        "GIT_COMMITTER_EMAIL": GIT_USER_EMAIL,
    }
    proc = subprocess.run([git_bin, "-c", "core.hooksPath=/dev/null", *args],
                          cwd=cwd, capture_output=True, text=True, env=env)
    if proc.returncode != 0:
        # ONE sentence: the last line git said, or nothing if it said nothing.
        said = (proc.stderr or proc.stdout).strip().splitlines()
        fail(f"git {args[0]} failed ({proc.returncode}): "
             f"{said[-1] if said else 'no output'}")
    return proc.stdout


def remix_app(apps_root, www_root, parent: str, child: str, *,
              git_bin: str = GIT, rsync_bin: str = RSYNC,
              stamp: "str | None" = None) -> dict:
    """Clone one app into a new one, lineage in the git log.

    `--no-local --no-hardlinks`: a local clone shares objects by hardlink by
    default, and two apps that are separately writable must not share a byte on
    disk — `git gc` in one would be reaching into the other's history. And the
    parent's `.git` must be the parent's OWN directory, not a `gitdir:` pointer
    file a turn wrote into /work (`_is_a_real_repo` above, Gable #2546).

    The empty commit is the lineage record. Not a note, not a file the next
    turn can rewrite, not a row only the database knows: `git log` in the
    child says where it came from, and it says it inside the artefact that
    gets copied around.

    The parent's PREVIEW, not its `live`, is what the child starts from: a
    remix opens a build session, and the thing a build session shows is a
    preview. It is published by the same staged-rename discipline as
    everything else here, so the child's preview root either exists complete
    or does not exist."""
    parent = check_app_id(parent)
    child = check_app_id(child)
    if parent == child:
        die("a remix's parent and child cannot be the same app")

    src = Path(apps_root) / parent
    dst = Path(apps_root) / child
    if not _real_dir(src) or not _is_a_real_repo(src):
        die(f"no app repository to remix from: {parent} "
            f"(its .git must be a real directory of its own)")
    if dst.exists() or dst.is_symlink():
        die(f"{child} already exists — a remix never writes over an app")

    # `--no-local`: without it git clones a local path by copying the object
    # store directly, which is how an `objects/info/alternates` in the parent
    # would travel into the child and make the child's history depend on a
    # tree the child does not own. `--no-local` makes even a path on this disk
    # go through the pack protocol, which carries objects and nothing else.
    # `--no-hardlinks` is kept: it is what --no-local implies, said out loud,
    # and it is the one that survives if this ever stops being a local clone.
    _git(["clone", "--no-local", "--no-hardlinks", "--quiet",
          str(src), str(dst)], git_bin=git_bin)
    # 0750, the mode every app repo has: an app's SOURCE is the seat's own and
    # the served copy is the world-readable one (spec §C).
    os.chmod(dst, 0o750)
    _git(["config", "user.name", GIT_USER_NAME], cwd=dst, git_bin=git_bin)
    _git(["config", "user.email", GIT_USER_EMAIL], cwd=dst, git_bin=git_bin)
    _git(["commit", "--allow-empty", "-q", "-m", f"remix of {parent}"],
         cwd=dst, git_bin=git_bin)

    published = False
    parent_preview = Path(www_root) / parent / PREVIEW_NAME
    if _real_dir(parent_preview):
        child_app = Path(www_root) / child
        if not child_app.is_dir():
            os.makedirs(child_app, exist_ok=True)
            os.chmod(child_app, 0o755)   # the served path; the gate reads it
        staged = (_staging(www_root, child)
                  / f"{PREVIEW_NAME}.tmp.{stamp or _stamp()}")
        _snapshot_into(parent_preview, staged, rsync_bin)
        target = child_app / PREVIEW_NAME
        if target.exists() or target.is_symlink():
            _remove(target)              # child_app was ours a moment ago
        os.rename(staged, target)
        published = True
    return {"mode": "remix", "parent": parent, "child": child,
            "repo": str(dst), "preview": published}


# ------------------------------------------------- the pre-flight refusals
#
# Read-only checks root makes BEFORE it starts a unit. Each of them is made
# again by the seat inside the unit, on the same facts; these exist so the
# common refusals cost a stat instead of a transient service, and so the house
# gets its one sentence back in milliseconds.

def active_turn_for_app(app_id: str, *, systemctl_bin: str = SYSTEMCTL) -> "str | None":
    """The name of a RUNNING turn unit of this app, or None.

    A turn's unit name is `disjorn-apps-<session>-<turn>` and carries no app
    id — `stop` derives it from the session and turn it is handed, and a
    publish is handed neither. So the id is read off the unit's Description,
    which build_run_argv sets to `Disjorn apps turn <s>/<t> (<app>)`; the
    serving units' descriptions carry no parentheses, so this can never match
    itself.

    ADVISORY, DELIBERATELY. A publish while a turn is mid-harvest could rsync
    a preview root that is being renamed out from under it, and the answer to
    that is a clear refusal rather than a half-copied `live`. But systemd not
    answering is not evidence of a running turn, so a query that fails at all
    reports None and says so: the failure mode of guessing "yes" is a Live
    button that never works, and that is worse than the race this closes."""
    try:
        listing = subprocess.run(
            [systemctl_bin, "list-units", "--no-legend", "--no-pager",
             "--plain", "--state=active", f"{UNIT_PREFIX}*.service"],
            capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError) as exc:
        warn(f"cannot ask systemd which turns are running ({exc}); "
             f"publishing without that check")
        return None
    if listing.returncode != 0:
        warn("cannot ask systemd which turns are running "
             f"({(listing.stderr or '').strip()}); publishing without that check")
        return None
    for line in listing.stdout.splitlines():
        unit = line.split()[0] if line.split() else ""
        if not unit.startswith(UNIT_PREFIX) or not unit.endswith(".service"):
            continue
        try:
            shown = subprocess.run(
                [systemctl_bin, "show", "--property=Description", "--value",
                 unit], capture_output=True, text=True, timeout=10)
        except (OSError, subprocess.SubprocessError):
            continue
        if shown.returncode == 0 and f"({app_id})" in shown.stdout:
            return unit
    return None


def preflight_publish(app_id: str, *, www_root: str = WWW_ROOT,
                      systemctl_bin: str = SYSTEMCTL) -> None:
    preview = Path(www_root) / app_id / PREVIEW_NAME
    if not _real_dir(preview):
        die(f"{app_id} has no preview to publish "
            f"(no turn of this app has deployed yet)")
    unit = active_turn_for_app(app_id, systemctl_bin=systemctl_bin)
    if unit:
        die(f"{app_id} has a turn running ({unit}); publish when it idles")


def preflight_revert(app_id: str, *, www_root: str = WWW_ROOT) -> None:
    app_dir = Path(www_root) / app_id
    if not _real_dir(app_dir / LIVE_NAME):
        die(f"{app_id} is not live, so there is nothing to revert")
    if not _real_dir(app_dir / PREV_NAME):
        die(f"{app_id} has no previous deploy to revert to")


def preflight_remix(parent: str, child: str, *, apps_root: str = APPS_ROOT) -> None:
    if parent == child:
        die("a remix's parent and child cannot be the same app")
    src = Path(apps_root) / parent
    if not _real_dir(src) or not _is_a_real_repo(src):
        die(f"no app repository to remix from: {parent} "
            f"(its .git must be a real directory of its own)")
    dst = Path(apps_root) / child
    if dst.exists() or dst.is_symlink():
        die(f"{child} already exists — a remix never writes over an app")


# --------------------------------------------------- the serving-mode argv

def build_op_argv(mode: str, ids: "list", *, self_path: str = SELF,
                  seat=None) -> "list":
    """The exact systemd-run argv for a serving operation. Same contract as
    build_run_argv: factored out so the suite asserts it byte for byte.

    `--wait` (not `run`'s fire-and-forget) because the house server is holding
    a request open on the answer, and `--pipe` so the seat's one sentence and
    its exit code come back through sudo unchanged. `--quiet` because without
    it systemd-run writes four lines of its own to stderr ("Running as unit",
    "Finished with result", the CPU and memory it used) and the caller's
    contract is ONE sentence — the server puts that sentence in front of a
    user. `--collect` so a failed operation leaves no unit behind to collide
    with the retry."""
    pw, group = seat if seat is not None else check_seat()
    unit = f"{UNIT_PREFIX}{mode}-{'-'.join(ids)}"
    what = {"publish": f"Disjorn apps publish {ids[0]}",
            "revert": f"Disjorn apps revert {ids[0]}",
            "remix": f"Disjorn apps remix {' to '.join(ids)}"}[mode]
    return [
        SYSTEMD_RUN,
        # One unit name per (mode, app): a second publish of the same app
        # while the first is in flight collides LOUDLY instead of racing the
        # rotate. The same reasoning as the turn unit's name.
        f"--unit={unit}",
        f"--description={what}",
        # THE IDENTITY. Everything under /srv/apps and /srv/apps-www belongs
        # to this account, and root moving directories inside a tree the seat
        # controls is the shape this whole file exists to avoid.
        f"--uid={SEAT_USER}",
        f"--gid={group}",
        "--collect",
        "--wait",
        "--pipe",
        "--quiet",
        f"--property=RuntimeMaxSec={OP_MAX_SEC}",
        f"--property=MemoryMax={OP_MEMORY_MAX}",
        f"--property=LimitFSIZE={LIMIT_FSIZE}",
        "--property=LimitCORE=0",
        f"--property=TasksMax={OP_TASKS_MAX}",
        f"--setenv=HOME={pw.pw_dir}",
        "--",
        self_path, f"{mode}-as-seat", *ids,
    ]


def main_op(mode: str, argv: "list", *, dry: bool, seat, self_path: str,
            systemctl_bin: str = SYSTEMCTL, www_root: str = WWW_ROOT,
            apps_root: str = APPS_ROOT) -> int:
    """The privileged half of publish/revert/remix: shapes, pre-flight, argv,
    exec. No file is touched here — root's job is to decide, and the seat's is
    to move."""
    ids = argv[2:]
    want = 2 if mode == "remix" else 1
    if len(ids) != want:
        die(f"{mode} takes exactly {want} argument{'s' if want > 1 else ''}, "
            f"got {len(ids)}")
    ids = [check_app_id(i) for i in ids]
    if mode == "publish":
        preflight_publish(ids[0], www_root=www_root, systemctl_bin=systemctl_bin)
    elif mode == "revert":
        preflight_revert(ids[0], www_root=www_root)
    else:
        preflight_remix(ids[0], ids[1], apps_root=apps_root)
    if not dry:
        check_wrapper(self_path)
    out = build_op_argv(mode, ids, self_path=self_path, seat=seat)
    if dry:
        print(json.dumps(out))
        return 0
    os.execve(out[0], out, {"PATH": "/usr/sbin:/usr/bin:/sbin:/bin"})
    die(f"exec failed: {out[0]}")   # pragma: no cover — execve does not return
    return EXIT_REFUSED


def main_as_seat(mode: str, argv: "list", *, www_root: str = WWW_ROOT,
                 apps_root: str = APPS_ROOT) -> int:
    """The unprivileged half, inside the transient unit, as res-appsbuilding.

    Reachable by name only from build_op_argv above: the sudoers regexes are
    anchored on `^publish <id>$` and friends, so no caller of this file through
    sudo can ever name a `-as-seat` mode. Running it as yourself gives you
    exactly your own privileges, and running it as root is refused — root has
    no business moving directories in the seat's own trees, which is the
    ruling the whole serving half is built on."""
    if os.geteuid() == 0:
        die(f"{mode} never runs as root; it is the seat's half of "
            f"{mode.split('-')[0]}")
    ids = argv[2:]
    want = 2 if mode.startswith("remix") else 1
    if len(ids) != want:
        die(f"{mode} takes exactly {want} argument{'s' if want > 1 else ''}, "
            f"got {len(ids)}")
    ids = [check_app_id(i) for i in ids]
    try:
        if mode == "publish-as-seat":
            out = publish_app(www_root, ids[0])
        elif mode == "revert-as-seat":
            out = revert_app(www_root, ids[0])
        else:
            out = remix_app(apps_root, www_root, ids[0], ids[1])
    except OSError as exc:
        fail(f"{mode}: {exc}")
    print(json.dumps(out))
    return 0


def main(argv: "list") -> int:
    # DRY RUN is for the test suite and for reading the argv at the keyboard.
    # It is UNREACHABLE through the privileged path: sudo's env_reset (Debian
    # default) drops DISJORN_* before this process starts, so the sudoers rule
    # can only ever reach the exec'ing branch. It still runs every check.
    dry = os.environ.get("DISJORN_APPS_LAUNCH_DRY_RUN") == "1"
    # The config path override is likewise env_reset'd away on the privileged
    # path. It exists so a test (and a keyboard rehearsal) can point at a
    # scratch table without giving any caller a second code path.
    config_path = os.environ.get("DISJORN_APPS_LAUNCH_CONFIG") or CONFIG_PATH
    wrapper = WRAPPER
    harvest = HARVEST
    if dry and os.environ.get("DISJORN_APPS_LAUNCH_WRAPPER"):
        wrapper = os.environ["DISJORN_APPS_LAUNCH_WRAPPER"]
    if dry and os.environ.get("DISJORN_APPS_LAUNCH_HARVEST"):
        harvest = os.environ["DISJORN_APPS_LAUNCH_HARVEST"]
    self_path = SELF
    if dry and os.environ.get("DISJORN_APPS_LAUNCH_SELF"):
        self_path = os.environ["DISJORN_APPS_LAUNCH_SELF"]
    systemctl_bin = SYSTEMCTL
    if dry and os.environ.get("DISJORN_APPS_LAUNCH_SYSTEMCTL"):
        systemctl_bin = os.environ["DISJORN_APPS_LAUNCH_SYSTEMCTL"]
    # The two /srv roots the serving modes move things in. Constants on the
    # real path; a scratch tree under a dry run, so the suite proves the rotate
    # on a tree it owns instead of on the house's.
    www_root, apps_root = WWW_ROOT, APPS_ROOT
    if dry and os.environ.get("DISJORN_APPS_LAUNCH_WWW_ROOT"):
        www_root = os.environ["DISJORN_APPS_LAUNCH_WWW_ROOT"]
    if dry and os.environ.get("DISJORN_APPS_LAUNCH_APPS_ROOT"):
        apps_root = os.environ["DISJORN_APPS_LAUNCH_APPS_ROOT"]

    if len(argv) < 2 or argv[1] not in MODES:
        die("usage: disjorn-apps-launch run <resident> <session> <turn> "
            "<app-id> <prompt-path> | stop <resident> <session> <turn> "
            "| publish <app-id> | revert <app-id> | remix <parent> <child>")

    # The seat's half of a serving operation, inside the transient unit. No
    # seat lookup, no config, no privilege: it IS the seat, and it moves
    # directories it owns.
    if argv[1].endswith("-as-seat"):
        return main_as_seat(argv[1], argv, www_root=www_root,
                            apps_root=apps_root)

    seat = None
    if dry and os.environ.get("DISJORN_APPS_LAUNCH_FAKE_SEAT"):
        # A test box has no res-appsbuilding. The FAKE_SEAT override is
        # dry-run-only for the same reason every other override is.
        uid, home, group = os.environ["DISJORN_APPS_LAUNCH_FAKE_SEAT"].split(":")
        seat = (type("pw", (), {"pw_uid": int(uid), "pw_dir": home})(), group)

    if argv[1] in ("publish", "revert", "remix"):
        # No config and no prompt: a serving operation names apps, and every
        # root it touches is a constant in this file.
        return main_op(argv[1], argv, dry=dry, seat=seat or check_seat(),
                       self_path=self_path, systemctl_bin=systemctl_bin,
                       www_root=www_root, apps_root=apps_root)

    if argv[1] == "stop":
        # No config, no wrapper, no prompt: a stop names a turn and nothing
        # else, and the only thing it reads is the seat's uid for the marker.
        return main_stop(argv, dry=dry, seat=seat or check_seat())

    if len(argv) != 7:
        die(f"run takes exactly 5 arguments, got {len(argv) - 2}")

    config = load_config(config_path)
    if seat is None and not dry:
        check_wrapper(wrapper)

    # ONE open of the prompt, before anything else, and the argv is built
    # around that fd — the name is never consulted again.
    prompt_fd = open_prompt(argv[2], argv[6], config)
    out = build_run_argv(argv[2], argv[3], argv[4], argv[5], argv[6], config,
                         wrapper=wrapper, harvest=harvest, seat=seat,
                         prompt_fd=prompt_fd)

    if dry:
        os.close(prompt_fd)
        print(json.dumps(out))
        return 0
    data = read_prompt_fd(prompt_fd, config)
    prompt_on_stdin(data)
    # Fixed argv, no shell, and exec (not fork): the descriptors the caller
    # handed us pass straight through, and sudo's child IS systemd-run, so the
    # unit's start status comes back to the caller unchanged. A scrubbed
    # environment too — this program runs as root and inherits nothing it was
    # not handed on purpose; the UNIT's environment comes from PID 1, which is
    # why every --setenv= above exists.
    os.execve(out[0], out, {"PATH": "/usr/sbin:/usr/bin:/sbin:/bin"})
    die(f"exec failed: {out[0]}")   # pragma: no cover — execve does not return
    return EXIT_REFUSED


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
